        f16vec4 c3 = f16vec4(textureLodOffset(srcNbr3, uv, 0.0, ivec2(ox, oy))); \
        sa = dot(a0, c0) + dot(a1, c1) + dot(a2, c2) + dot(a3, c3); \
        sb = dot(b0, c0) + dot(b1, c1) + dot(b2, c2) + dot(b3, c3); \
