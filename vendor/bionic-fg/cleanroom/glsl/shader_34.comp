    imageStore(dstHead0, p, vec4((h1 - kDeq0A) * kDeq1A + kDeq2A));

    f16vec4 h2 = ((((kR1 * nA1 + kR2 * nA2) + kQ3 * nA3) + kR3 * nB1) + kR4 * nB2) + kQ4 * nB3;
