    f16vec4 nB2 = clamp((f16vec4(sb4, sb5, sb6, sb7) - kZero2) * kScale2 + kOfs2, 0.0hf, 1.0hf);
    float16_t nB3 = clamp((sb8 - kZero3) * kScale3 + kOfs3, 0.0hf, 1.0hf);

