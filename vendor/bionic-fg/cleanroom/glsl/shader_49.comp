        c[k] = ((dot(m0, t0[k]) + dot(m1, t1[k])) + dot(m2, t2[k])) + dot(m3, t3[k]);
    }
    q1 = clamp((f16vec4(c[0], c[1], c[2], c[3]) - NORM1_M) * NORM1_S + NORM1_B,
               f16vec4(0.0hf), f16vec4(1.0hf));
    q2 = clamp((f16vec4(c[4], c[5], c[6], c[7]) - NORM2_M) * NORM2_S + NORM2_B,
