{
  "name": "decky-lsfg-vk",
  "version": "0.12.8",
  "description": "Use Lossless Scaling on the Steam Deck using the lsfg-vk vulkan layer",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "test": "node --experimental-strip-types --test tests/steamLaunchOptions.test.ts && python3 -m unittest discover -s tests -p 'test_*.py'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xXJSONDeruloXx/decky-lsfg-vk.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam-deck",
    "deck",
    "lossless-scaling",
    "frame-generation",
    "lsfg-vk",
    "framegen"
  ],
  "author": "Kurt Himebauch <dkh4830@gmail.com>",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/xXJSONDeruloXx/decky-lossless-scaling-vk/issues"
  },
  "homepage": "https://github.com/xXJSONDeruloXx/decky-lossless-scaling-vk#readme",
  "devDependencies": {
    "@decky/rollup": "^1.0.1",
    "@decky/ui": "^4.7.2",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.22.5",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.2",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.22.5",
    "@rollup/rollup-linux-x64-musl": "4.22.5"
  },
  "remote_binary_bundling" : true,
  "remote_binary": [
    {
      "name": "lsfg-vk-2.0.0.tar.xz",
      "url": "https://builds.lsfg-vk.dev/lsfg-vk-2.0.0.tar.xz",
      "sha256hash": "08bdbdf373a111022df87dac7aa87e3b564bb841f961552e3ca85fea12b5aa74"
    }
  ],
  "pnpm": {
    "supportedArchitectures": {
      "cpu": ["arm64", "x64"],
      "libc": ["glibc", "musl"],
      "os": ["darwin", "linux"]
    },
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
