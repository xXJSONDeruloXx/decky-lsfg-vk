    if (p.x >= lim.x || p.y >= lim.y) {
        return;
    }
    vec2 uv = (vec2(p * 2) + 0.5) / vec2(textureSize(featA, 0));

    f16vec4 t0 = f16vec4(textureLodOffset(featA, uv, 0.0, ivec2(-1, -1)));
    f16vec4 t1 = f16vec4(textureLodOffset(featA, uv, 0.0, ivec2(-1, 0)));
