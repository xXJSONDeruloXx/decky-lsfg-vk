    f16vec4 t8 = f16vec4(textureLodOffset(featA, uv, 0.0, ivec2(1, 1)));

    f16vec4 s0 = w48_0 * t0;
    s0 += w48_1 * t1;
    s0 += w48_2 * t2;
    s0 += w48_3 * t3;
    s0 += w48_4 * t4;
    s0 += w48_5 * t5;
    s0 += w48_6 * t6;
    s0 += w48_7 * t7;
    s0 += w48_8 * t8;
    imageStore(plane0, p, vec4((s0 - sub48) * mul48 + add48));

    f16vec4 s1 = w49_0 * t0;
    s1 += w49_1 * t1;
    s1 += w49_2 * t2;
    s1 += w49_3 * t3;
    s1 += w49_4 * t4;
    s1 += w49_5 * t5;
    s1 += w49_6 * t6;
    s1 += w49_7 * t7;
    s1 += w49_8 * t8;
    imageStore(plane1, p, vec4((s1 - sub49) * mul49 + add49));
}
