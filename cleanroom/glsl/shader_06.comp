#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 32) uniform sampler2D srcTex;
layout(set = 0, binding = 48, rgba8) uniform writeonly image2D dst;

const f16mat4 M1 = f16mat4(
    f16vec4(0.28100585938hf, 0.396484375hf, 0.20422363281hf, 0.18115234375hf),
    f16vec4(0.0022754669189hf, 0.0083007812500hf, -0.0066604614258hf, 0.017120361328hf),
    f16vec4(-0.28930664062hf, -0.19592285156hf, -0.28198242188hf, -0.0029315948486hf),
    f16vec4(0.017227172852hf, 0.076110839844hf, -0.38549804688hf, 0.042022705078hf));

const f16mat4 M2 = f16mat4(
    f16vec4(-0.042236328125hf, 0.57373046875hf, 0.32958984375hf, 0.18994140625hf),
    f16vec4(0.014884948730hf, 0.051116943359hf, -0.031829833984hf, 0.0067481994629hf),
    f16vec4(0.0032176971436hf, -0.3828125hf, -0.37084960938hf, 0.028533935547hf),
    f16vec4(-0.0380859375hf, 0.072448730469hf, 0.016708374023hf, 0.061370849609hf));

const f16mat4 M3 = f16mat4(
    f16vec4(-0.33666992188hf, 0.34155273438hf, 0.17761230469hf, 0.029235839844hf),
    f16vec4(-0.022705078125hf, -0.055694580078hf, -0.032562255859hf, 0.0034389495850hf),
    f16vec4(0.27124023438hf, -0.20324707031hf, -0.33984375hf, 0.0049285888672hf),
    f16vec4(-0.0074043273926hf, 0.16552734375hf, -0.18872070312hf, 0.037658691406hf));

const f16mat4 M4 = f16mat4(
    f16vec4(0.52294921875hf, 0.071228027344hf, -0.044586181641hf, 0.058410644531hf),
    f16vec4(-0.012573242188hf, 0.027557373047hf, 0.1142578125hf, 0.021209716797hf),
    f16vec4(-0.42456054688hf, -0.03857421875hf, 0.096130371094hf, -0.019409179688hf),
    f16vec4(0.015853881836hf, -0.31396484375hf, 0.085205078125hf, 0.088500976562hf));

const f16mat4 M5 = f16mat4(
    f16vec4(0.067443847656hf, 0.068237304688hf, -0.036346435547hf, 0.20202636719hf),
    f16vec4(-0.023071289062hf, 0.028823852539hf, 0.10894775391hf, 0.011940002441hf),
    f16vec4(0.021423339844hf, -0.036193847656hf, 0.16223144531hf, 0.036865234375hf),
    f16vec4(-0.037322998047hf, -0.26611328125hf, 0.4873046875hf, 0.12780761719hf));

const f16mat4 M6 = f16mat4(
    f16vec4(-0.48461914062hf, -0.0050849914551hf, -0.0051536560059hf, 0.18518066406hf),
    f16vec4(-0.022323608398hf, 0.012138366699hf, 0.12139892578hf, -0.00022995471954hf),
    f16vec4(0.42041015625hf, -0.031524658203hf, 0.053558349609hf, 0.026870727539hf),
    f16vec4(0.050903320312hf, -0.44946289062hf, 0.30541992188hf, 0.095520019531hf));

const f16mat4 M7 = f16mat4(
    f16vec4(0.31689453125hf, -0.37719726562hf, -0.013618469238hf, -0.22326660156hf),
    f16vec4(-0.028625488281hf, -0.018066406250hf, -0.084777832031hf, 0.040496826172hf),
    f16vec4(-0.2666015625hf, 0.16943359375hf, 0.085571289062hf, -0.024078369141hf),
    f16vec4(-0.032562255859hf, 0.15759277344hf, -0.34887695312hf, -0.058319091797hf));

const f16mat4 M8 = f16mat4(
    f16vec4(0.058258056641hf, -0.580078125hf, -0.34692382812hf, -0.0083084106445hf),
    f16vec4(0.025192260742hf, 0.011932373047hf, -0.086120605469hf, 0.013916015625hf),
    f16vec4(0.0084915161133hf, 0.3330078125hf, 0.5546875hf, 0.040649414062hf),
    f16vec4(-0.017013549805hf, 0.29858398438hf, 0.32690429688hf, -0.061126708984hf));

const f16mat4 M9 = f16mat4(
    f16vec4(-0.38623046875hf, -0.49340820312hf, -0.28295898438hf, 0.17102050781hf),
    f16vec4(0.035369873047hf, 0.023452758789hf, -0.081604003906hf, -0.016952514648hf),
    f16vec4(0.26416015625hf, 0.32910156250hf, 0.47753906250hf, 0.018386840820hf),
    f16vec4(0.13903808594hf, 0.023025512695hf, -0.084228515625hf, -0.021194458008hf));

const f16vec4 OUT_B1 = f16vec4(0.0021209716797hf, -0.0070228576660hf, 0.026550292969hf, 0.10119628906hf);
const f16vec4 OUT_G  = f16vec4(4.10546875hf, 8.515625hf, 5.17578125hf, 2.251953125hf);
const f16vec4 OUT_B2 = f16vec4(0.10455322266hf, 0.27416992188hf, -0.13793945312hf, -0.16271972656hf);

#define TAP(ox, oy) f16vec4(textureLodOffset(srcTex, uv, 0.0, ivec2(ox, oy)))

void main() {
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(gid, imageSize(dst))))
        return;

    vec2 srcSize = vec2(textureSize(srcTex, 0));
    vec2 uv = (vec2(gid) + 0.5) / srcSize;

    f16vec4 acc = M1 * TAP(-1, -1);
    acc += M2 * TAP(-1, 0);
    acc += M3 * TAP(-1, 1);
    acc += M4 * TAP(0, -1);
    acc += M5 * TAP(0, 0);
    acc += M6 * TAP(0, 1);
    acc += M7 * TAP(1, -1);
    acc += M8 * TAP(1, 0);
    acc += M9 * TAP(1, 1);

    f16vec4 res = (acc - OUT_B1) * OUT_G + OUT_B2;
    imageStore(dst, gid, vec4(res));
}
