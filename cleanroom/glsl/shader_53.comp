void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 lim = imageSize(dstConv);
    if (p.x >= lim.x || p.y >= lim.y) {
        return;
    }
    vec2 uv = (vec2(p) + 0.5) / vec2(textureSize(srcFeatA, 0));

    f16vec4 acc;
    acc  = kWX1 * f16vec4(textureLodOffset(srcFeatA, uv, 0.0, ivec2(-1, -1)));
    acc += kWX2 * f16vec4(textureLodOffset(srcFeatA, uv, 0.0, ivec2(-1,  0)));
    acc += kWX3 * f16vec4(textureLodOffset(srcFeatA, uv, 0.0, ivec2(-1,  1)));
    acc += kWX4 * f16vec4(textureLodOffset(srcFeatA, uv, 0.0, ivec2( 0, -1)));
    acc += kWX5 * f16vec4(textureLod(srcFeatA, uv, 0.0));
    acc += kWX6 * f16vec4(textureLodOffset(srcFeatA, uv, 0.0, ivec2( 0,  1)));
    acc += kWX7 * f16vec4(textureLodOffset(srcFeatA, uv, 0.0, ivec2( 1, -1)));
    acc += kWX8 * f16vec4(textureLodOffset(srcFeatA, uv, 0.0, ivec2( 1,  0)));
    acc += kWX9 * f16vec4(textureLodOffset(srcFeatA, uv, 0.0, ivec2( 1,  1)));
    acc += kWY1 * f16vec4(textureLodOffset(srcFeatB, uv, 0.0, ivec2(-1, -1)));
    acc += kWY2 * f16vec4(textureLodOffset(srcFeatB, uv, 0.0, ivec2(-1,  0)));
    acc += kWY3 * f16vec4(textureLodOffset(srcFeatB, uv, 0.0, ivec2(-1,  1)));
    acc += kWY4 * f16vec4(textureLodOffset(srcFeatB, uv, 0.0, ivec2( 0, -1)));
    acc += kWY5 * f16vec4(textureLod(srcFeatB, uv, 0.0));
    acc += kWY6 * f16vec4(textureLodOffset(srcFeatB, uv, 0.0, ivec2( 0,  1)));
    acc += kWY7 * f16vec4(textureLodOffset(srcFeatB, uv, 0.0, ivec2( 1, -1)));
    acc += kWY8 * f16vec4(textureLodOffset(srcFeatB, uv, 0.0, ivec2( 1,  0)));
    acc += kWY9 * f16vec4(textureLodOffset(srcFeatB, uv, 0.0, ivec2( 1,  1)));
    acc += kBias;
    acc += f16vec4(textureLod(srcSkip, uv, 0.0));
    imageStore(dstConv, p, vec4(acc));
}
