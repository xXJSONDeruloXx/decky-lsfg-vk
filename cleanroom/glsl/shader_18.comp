        r1 += w1_13 * t13;
        r1 += w1_14 * t14;
        r1 += w1_15 * t15;
        r1 += w1_16 * t16;
        r1 += w1_17 * t17;
        r1 = (r1 - sub1) * mul1 + add1;
        imageStore(dstB, p, vec4(r1));
    }
